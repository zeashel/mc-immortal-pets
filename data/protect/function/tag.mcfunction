execute as @e[type=minecraft:parrot] if data entity @s Owner run tag @s add immortal_pets
execute as @e[type=minecraft:horse] if data entity @s Owner run tag @s add immortal_pets
execute as @e[type=minecraft:donkey] if data entity @s Owner run tag @s add immortal_pets
execute as @e[type=minecraft:llama] if data entity @s Owner run tag @s add immortal_pets
execute as @e[type=minecraft:trader_llama] if data entity @s Owner run tag @s add immortal_pets
