# tags all pets with Owner NBT with a custom zeashel_immortal_pets_hVXdIng tag
execute as @e[type=minecraft:wolf] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:cat] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:parrot] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:horse] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:donkey] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:llama] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
execute as @e[type=minecraft:trader_llama] if data entity @s Owner run tag @s add zeashel_immortal_pets_hVXdIng
